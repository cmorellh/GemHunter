# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# IDE / project files (regenerated by UE)
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace
compile_commands.json

# Compiled objects
*.o
*.so
*.dll
*.pdb
*.lib
*.a
*.exe
*.app

# Cooked / packaged output
*.pak
Packaged/

# OS
.DS_Store
Thumbs.db

# Secrets (API keys for Mindat, api.data.gov, etc.)
.env
*.key

# --- Added with the UE5 project skeleton ---

# Unreal generated project files
*.xcodeproj/
*.xcworkspace/
*.uprojectdirs

# Unreal crash/profiling output
Saved/Crashes/
Saved/Logs/
Saved/Profiling/

# UnrealBuildTool / UnrealHeaderTool output that can land outside Intermediate
.ubt/
*.target
*.modules
*.version

# Visual Studio local state
*.vcxproj.user
*.csproj.user
*.rsp

# Engine-local plugin builds
Plugins/**/Saved/

# Python tooling for the data pulls (Smithsonian / Mindat / USGS)
__pycache__/
*.pyc
.venv/
venv/

# UE 5.8+ XML solution format, and the automation solution, both generated
*.slnx
Automation_*.sln
Automation_*.slnx

# Generated by UnrealBuildTool; pins an exact MSVC toolset version, so it
# churns per machine. Required VS components are documented in README.md.
.vsconfig
